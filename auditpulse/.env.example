# Postgres connection string (Vercel Postgres, Neon, Supabase, etc.)
# Required in production. Locally, copy this file to .env and fill it in.
DATABASE_URL=postgres://user:password@host:5432/database

# Public URL of this deployment, used in emailed report links and Stripe
# redirect URLs.
PUBLIC_SITE_URL=https://auditpulse.example.com

# Clerk (clerk.com) — sign-in with Google, Microsoft, email+password, email magic link.
# Publishable key must be set at BUILD time (Vite inlines VITE_ vars), so set it
# as a Vercel env var before deploying, not just at runtime.
VITE_CLERK_PUBLISHABLE_KEY=pk_test_xxxxxxxx
CLERK_SECRET_KEY=sk_test_xxxxxxxx
# From Clerk Dashboard -> Webhooks -> your endpoint's signing secret (starts with whsec_)
CLERK_WEBHOOK_SECRET=whsec_xxxxxxxx

# Resend (resend.com) — sends report emails and account notifications.
RESEND_API_KEY=re_xxxxxxxx

# Stripe — $100/month "Unlimited" subscription.
STRIPE_SECRET_KEY=sk_test_xxxxxxxx
# From Stripe Dashboard -> Webhooks -> your endpoint's signing secret
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxx
# Price id for the recurring $100/month plan (Stripe Dashboard -> Product catalog)
STRIPE_PRICE_ID=price_xxxxxxxx

# Shared secret required in the Authorization header of cron-triggered
# requests, so /api/cron/rescan can't be invoked by anyone who finds the URL.
# Vercel Cron sends this automatically when set as CRON_SECRET.
CRON_SECRET=change-me-to-a-long-random-value

# Optional: internal notifications (new signups, failed scans, etc).
ADMIN_EMAIL=you@example.com
