# Postgres connection string (Neon, Vercel Postgres, Supabase, or local).
DATABASE_URL="postgres://user:password@host:5432/dbname"

# Stripe secret key and webhook signing secret, from the Stripe dashboard.
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."

# Any long random string — used as the bearer token for /admin.html.
ADMIN_SECRET="change-me-to-something-long-and-random"

# The deployed origin, used to build Stripe Checkout success/cancel URLs.
PUBLIC_SITE_URL="http://localhost:5173"
