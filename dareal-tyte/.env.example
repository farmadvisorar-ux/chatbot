# Vercel API token used to create deployments and attach custom domains.
# Create one at https://vercel.com/account/tokens.
VERCEL_TOKEN=

# Optional: set only if the target Vercel project lives under a team account.
VERCEL_TEAM_ID=

# Shared secret required (as `Authorization: Bearer <key>` or `x-api-key`
# header) to call any /api/* route. Generate with `openssl rand -hex 32`.
# Every route fails closed (501) if this is unset, so nothing is reachable
# by accident on a fresh deploy.
DAREAL_API_KEY=
