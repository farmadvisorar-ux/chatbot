# Vercel API token used to deploy *recovered* sites and manage their
# domains. Create one at https://vercel.com/account/tokens. Unrelated to
# whichever account this project itself happens to be deployed under.
VERCEL_TOKEN=

# Optional: set only if recovered sites should deploy under a Vercel team.
VERCEL_TEAM_ID=

# From a Clerk application at https://dashboard.clerk.com. The publishable
# key is baked into the frontend build (VITE_ prefix, not secret); the
# secret key is backend-only.
VITE_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# From https://dashboard.stripe.com/apikeys. Use a test-mode (sk_test_...)
# key until the full checkout flow has been verified with a test card.
STRIPE_SECRET_KEY=

# A one-time (not recurring) $18 Price ID in that Stripe account.
STRIPE_PRICE_ID=

# Signing secret for a Stripe webhook endpoint pointed at
# /api/webhooks/stripe, listening for checkout.session.completed.
STRIPE_WEBHOOK_SECRET=

# Optional: defaults to https://darealtyte.com. Used to build the Stripe
# Checkout success/cancel redirect URLs.
PUBLIC_SITE_URL=

# Optional, comma-separated. These email addresses (case-insensitive) skip
# payment entirely -- safe to set on production, unlike SKIP_PAYWALL, since
# it only exempts the listed addresses.
ADMIN_EMAILS=

# Testing only -- lets ANY signed-in user skip payment. Never set this on
# the production project; use ADMIN_EMAILS there instead.
SKIP_PAYWALL=
