# Secret used to sign auth session JWTs. Generate with: openssl rand -base64 32
AUTH_SECRET=change-me-to-a-long-random-string

# Path to the SQLite database file (created automatically on first run)
DATABASE_PATH=./data/domainiq.sqlite

# Optional: if set, verification/reset emails send for real via Resend.
# If unset, emails are logged to the server console and saved to /dev/emails
# so the whole flow still works end-to-end without any paid service.
RESEND_API_KEY=
EMAIL_FROM="DomainIQ <onboarding@resend.dev>"

# Public base URL, used to build links inside emails
NEXT_PUBLIC_BASE_URL=http://localhost:3000
