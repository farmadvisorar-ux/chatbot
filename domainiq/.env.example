# Secret used to sign auth session JWTs. Generate with: openssl rand -base64 32
AUTH_SECRET=change-me-to-a-long-random-string

# Postgres connection string (Vercel Postgres, Neon, Supabase, or any
# Postgres host). For local dev without Docker, a local Postgres works too:
# postgres://postgres:postgres@localhost:5432/domainiq
DATABASE_URL=

# Optional: if set, verification/reset emails send for real via Resend.
# If unset, emails are logged to the server console and saved to /dev/emails
# so the whole flow still works end-to-end without any paid service.
RESEND_API_KEY=
EMAIL_FROM="DomainIQ <onboarding@resend.dev>"

# Public base URL, used to build links inside emails
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# Optional: enables a live USPTO trademark search on every valuation
# report. Get a free key at https://account.uspto.gov/api-manager/.
# Without it, trademark screening falls back to a small built-in
# famous-mark heuristic and clearly labels itself as not a live check.
USPTO_API_KEY=
