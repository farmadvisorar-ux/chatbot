# Postgres connection string (Vercel Postgres, Neon, Supabase, etc.)
# Required in production. Locally, copy this file to .env and fill it in.
DATABASE_URL=postgres://user:password@host:5432/database

# Clerk (clerk.com) — sign-in with Google, Microsoft, email+password, email magic link.
# Publishable key must be set at BUILD time (Vite inlines VITE_ vars), so set it
# as a Vercel env var before deploying, not just at runtime.
VITE_CLERK_PUBLISHABLE_KEY=pk_test_xxxxxxxx
CLERK_SECRET_KEY=sk_test_xxxxxxxx
# From Clerk Dashboard -> Webhooks -> your endpoint's signing secret (starts with whsec_)
CLERK_WEBHOOK_SECRET=whsec_xxxxxxxx

# Resend (resend.com) — sends the welcome email on signup.
# Without a verified sending domain, delivery is limited to the Resend account's
# own address — see freshsaas/README.md.
RESEND_API_KEY=re_xxxxxxxx

# Stripe (stripe.com) — powers marketplace checkout and self-serve ad checkout.
# Without these, purchase endpoints report "not open yet" instead of crashing.
STRIPE_SECRET_KEY=sk_test_xxxxxxxx
# From the Stripe Dashboard -> Developers -> Webhooks -> your endpoint's signing secret.
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxx

# Used to build absolute URLs (Stripe success/cancel redirects). Defaults to
# https://freshsaas.online if unset.
PUBLIC_SITE_URL=https://your-domain.example

# Shared secret for the /admin dashboard (moderation, payouts, ad review).
# Pick a long random value; there is no per-user role system, just this key.
ADMIN_SECRET=change-me-to-a-long-random-value
