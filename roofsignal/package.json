{
    "name": "roofsignal",
    "private": true,
    "version": "0.1.0",
    "type": "module",
    "scripts": {
        "dev": "vite",
        "build": "vite build",
        "preview": "vite preview",
        "typecheck": "tsc --noEmit && tsc --noEmit -p api/tsconfig.json",
        "migrate": "node scripts/migrate.mjs",
        "migrate:http": "node scripts/migrate-http.mjs",
        "fetch:storms": "node --experimental-strip-types scripts/fetch-storm-events.mjs",
        "test": "node --experimental-strip-types --test tests/*.test.mjs"
    },
    "dependencies": {
        "@vercel/blob": "^0.27.1",
        "csv-parse": "^7.0.2",
        "leaflet": "^1.9.4",
        "pg": "^8.13.1"
    },
    "optionalDependencies": {
        "@rollup/rollup-linux-x64-gnu": "^4.0.0"
    },
    "devDependencies": {
        "@neondatabase/serverless": "^1.1.0",
        "@types/leaflet": "^1.9.14",
        "@types/pg": "^8.11.10",
        "@vercel/node": "^3.2.24",
        "typescript": "^5.7.0",
        "vite": "^6.0.0"
    }
}
