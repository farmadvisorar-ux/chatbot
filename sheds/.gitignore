node_modules/
dist/

# Every local environment file, not just `.env`. The root .gitignore covers
# that one name only, so `.env.local` and `.env.production` were tracked —
# and those are exactly the files a real credential ends up in.
.env*
!.env.example

# The repository root .gitignore carries `lib/` from a Python packaging
# template, which matches src/lib/ here and silently drops every source file
# in it — `git add -A` reports success and commits nothing. Re-included as a
# directory rather than file-by-file, because git will not re-include a file
# whose parent directory is excluded.
!src/lib/
