# Postgres connection string (Neon, Vercel Postgres, Supabase, or local).
# Neon/Vercel may also set POSTGRES_URL / DATABASE_URL_UNPOOLED — any of those work.
DATABASE_URL=postgres://user:password@host:5432/database

# Stripe (stripe.com) — powers advertiser checkout.
STRIPE_SECRET_KEY=sk_test_xxxxxxxx
# From Stripe Dashboard → Developers → Webhooks → your endpoint's signing secret.
# Endpoint URL: https://<your-domain>/api/webhooks/stripe
# Subscribe to: checkout.session.completed
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxx

# Shared secret for /admin.html (campaign + publisher review). Pick a long
# random value; there is no per-user role system, just this bearer key.
ADMIN_SECRET=change-me-to-a-long-random-value

# Used to build absolute Stripe success/cancel URLs. Defaults to
# https://sikads.com if unset — set this for local/preview deploys.
PUBLIC_SITE_URL=http://localhost:5173
