# Copy to .env for local work. On Vercel, set the same names with Production ticked.

# Any one of these is enough. Neon via the Vercel marketplace sets several.
DATABASE_URL=postgresql://user:pass@host/db?sslmode=require
# POSTGRES_URL=
# POSTGRES_PRISMA_URL=
# DATABASE_URL_UNPOOLED=
# POSTGRES_URL_NON_POOLING=

STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Long random string; pasted into /admin.html to review campaigns and publishers.
ADMIN_SECRET=

# Used for Stripe success/cancel URLs and the embed snippet origin.
PUBLIC_SITE_URL=http://localhost:5173
