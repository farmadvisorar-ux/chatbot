# Postgres connection string (Vercel Postgres, Neon, Supabase, etc.)
# Required in production. Locally, copy this file to .env and fill it in.
DATABASE_URL=postgres://user:password@host:5432/database

# PayPal (developer.paypal.com) — powers checkout.
# Create an app under My Apps & Credentials; use Sandbox credentials for testing.
PAYPAL_CLIENT_ID=Axxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
PAYPAL_CLIENT_SECRET=Exxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# From PayPal Developer Dashboard -> My Apps -> your app -> Webhooks -> Webhook ID.
# Optional but strongly recommended; without it webhook events are not verified.
PAYPAL_WEBHOOK_ID=
# Set to "sandbox" while testing, "live" (or unset) for production.
PAYPAL_MODE=sandbox

# Printful (printful.com) — print-on-demand fulfillment. Create a private
# token under Printful Dashboard -> Stores -> your store -> API.
PRINTFUL_API_KEY=xxxxxxxx
# Only needed if the token has access to more than one Printful store.
PRINTFUL_STORE_ID=
# Set to "false" while testing so new orders land as drafts in the Printful
# dashboard for manual confirmation instead of going straight to production.
PRINTFUL_AUTO_CONFIRM=true
# From Printful Dashboard -> Settings -> Webhooks, if you configure one to
# receive shipping updates at /api/webhooks/printful. Optional — without it
# the endpoint still accepts events, just unauthenticated.
PRINTFUL_WEBHOOK_SECRET=

# Flat-rate domestic shipping charged at checkout, in cents.
SHIPPING_FLAT_CENTS=500

# Used to build absolute URLs (PayPal return/cancel URLs). Defaults to
# https://tooiicy.com if unset.
PUBLIC_SITE_URL=https://tooiicy.com

# Shared secret for the /admin console (product catalog, orders, fulfillment
# retries). Pick a long random value; there is no per-user role system, just
# this key.
ADMIN_SECRET=change-me-to-a-long-random-value
