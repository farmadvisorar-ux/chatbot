# Auto-populated by Vercel when a Blob store is connected to this project
# (Project Settings -> Storage -> Create Database -> Blob). Only needed
# manually for local development with `vercel dev`.
BLOB_READ_WRITE_TOKEN=

# Optional: caps how many files a single job will download.
WMD_MAX_FILES=1000

# Optional: how long finished/abandoned jobs are kept before the daily
# cleanup cron deletes their Blob storage.
WMD_JOB_TTL_HOURS=24

# Optional: shared secret Vercel Cron sends as `Authorization: Bearer ...`
# when it calls /api/cron/cleanup. Vercel sets this automatically for
# Vercel Cron Jobs; only needed here if you call the endpoint yourself.
CRON_SECRET=
